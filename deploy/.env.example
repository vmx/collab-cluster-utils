# Copy to deploy/.env and adjust. deploy/.env is gitignored -- keep
# per-deployment paths and addresses out of the repo. See Config in
# src/collab_cluster_utils/publisher/config.py for defaults and full docs.

# collab-cluster-torrentizer's OUTPUT_DIR on this host.
WATCH_DIR=/path/to/torrentizer/output

# The node to notify -- host[:port], port defaults to 8001.
TARGET_NODE=10.0.0.5:8001

# This process's address as the target node reaches it. Required: it
# can't be self-detected, and the node fetches both the .torrent and the
# data from http://ADVERTISE_HOST:HTTP_PORT/.
ADVERTISE_HOST=10.0.0.9

# Usually fine as-is; override only if something else on this host already
# uses this port.
#BIND_HOST=0.0.0.0
#HTTP_PORT=8090

# Where the notified-datasets ledger lives. Defaults to a file next to
# wherever the process runs.
#STATE_DB_PATH=./collab-cluster-publisher-state.sqlite3

# --- collab-cluster-data-manager (runs next to a node; ignores the above) ---

# The policy file. Defaults to data-manager-policy.toml in the repo root.
#POLICY_PATH=./data-manager-policy.toml

# Also judge what other nodes already hold when first seen, not only what
# they take from where it left off (data-manager-cursors.json) -- for a first
# start, or after an outage longer than the nodes' change logs.
#BACKFILL=1

# --- collab-cluster-rescuer (runs next to a node instead of a data manager) ---

# How many bytes the node may hold.
#RESCUE_BYTES=2000000000000

# The collector to ask what's rare, host[:port]; port defaults to 8100.
#COLLECTOR=10.0.0.2
